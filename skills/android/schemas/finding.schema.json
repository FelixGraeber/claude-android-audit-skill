{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://felixgraeber.com/claude-android-audit/finding.schema.json",
  "title": "Android Audit Finding",
  "type": "object",
  "required": [
    "rule_id",
    "title",
    "severity",
    "confidence",
    "evidence"
  ],
  "properties": {
    "rule_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "requires_external_evidence": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
